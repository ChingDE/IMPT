# ─────────────────────────────────────────────────────────────────────────────
# IMPT v2 Environment Variables — Hostinger VPS + Neon setup
# For the original DigitalOcean setup described in the thesis, see .env.example.
# Copy to .env (cp .env.hostinger.example .env), fill every CHANGE_ME value,
# then lock it: chmod 600 .env
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database — Neon PostgreSQL (use the direct host, not the -pooler one) ─────
# Remove channel_binding=require from the string Neon gives you.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME.neon.tech/impt?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME.neon.tech/impt?sslmode=require

# ── Redis — container on this server (the redis service in docker-compose.yml)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# To use Upstash instead, drop the redis service and set all three to:
# rediss://:CHANGE_ME@CHANGE_ME.upstash.io:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Reuse the old SECRET_KEY: stored GitHub tokens are encrypted with a key
# derived from it, so a new one forces every user to re-link GitHub.
SECRET_KEY=CHANGE_ME_64_CHAR_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Email — Gmail API (Google Cloud, OAuth2 over HTTPS) ───────────────────────
# Email stays off unless the first three are set.
GMAIL_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=CHANGE_ME
GMAIL_REFRESH_TOKEN=CHANGE_ME
EMAIL_FROM=IMPT <novasoft.impt@gmail.com>
# Optional: where admin error alerts go
ADMIN_ALERT_EMAIL=

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://www.impt.it.com
API_BASE_URL=https://api.impt.it.com
ALLOWED_ORIGINS=https://impt.it.com,https://www.impt.it.com,https://CHANGE_ME.vercel.app

# ── GitHub account linking (OAuth app callback starts with API_BASE_URL) ──────
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
# Only if the old .env set one:
# GITHUB_TOKEN_KEY=

# ── Upload storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50
FILE_RETENTION_DAYS=90

# ── Session and security settings ─────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ── App ───────────────────────────────────────────────────────────────────────
IMPT_DEBUG=false
JOB_TIMEOUT_WATCHDOG_SECONDS=3900

# ── Docker socket access for the api and worker containers ────────────────────
# The number printed by: getent group docker | cut -d: -f3
DOCKER_GID=CHANGE_ME
