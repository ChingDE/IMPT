# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# ── Test artifacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.log

# ── Local dev databases ───────────────────────────────────────────────────────
impt_local.db
*.db
*.sqlite3

# ── Uploaded projects (mounted as Docker volume, not baked into image) ────────
uploads/

# ── Secrets — NEVER in image ──────────────────────────────────────────────────
.env
deploy/nginx/ssl/*.pem
deploy/nginx/ssl/*.key

# ── Version control ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Frontend (Vercel builds this — not needed inside the Docker image) ────────
frontend/
# Note: frontend/dist/ was previously served by Nginx.
# With cloud architecture, Vercel serves the frontend directly.
# The Dockerfile does not need any frontend files.

# ── Celery state ──────────────────────────────────────────────────────────────
celerybeat-schedule
celerybeat.pid

# ── Docs / extras ─────────────────────────────────────────────────────────────
*.md
LICENSE
