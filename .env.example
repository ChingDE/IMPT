# ─────────────────────────────────────────────────────────────────────────────
# IMPT Environment Variables
# Copy this file to .env and fill in every CHANGE_ME value.
# NEVER commit .env to version control.
#
# Architecture:
#   Database  → DigitalOcean Managed PostgreSQL
#   Cache     → Upstash Redis (TLS — note rediss:// not redis://)
#   Frontend  → Vercel (configured separately, not here)
#   API/Worker→ DigitalOcean Droplet (this file lives here)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database — DigitalOcean Managed PostgreSQL ────────────────────────────────
# Get these from: DO dashboard → Databases → your cluster → Connection Details
# Select "private network" host for fastest connection from your Droplet.
# Async driver for FastAPI:
DATABASE_URL=postgresql+asyncpg://doadmin:CHANGE_ME@private-CHANGE_ME.db.ondigitalocean.com:25060/impt?sslmode=require
# Sync driver for Alembic migrations:
DATABASE_URL_SYNC=postgresql+psycopg2://doadmin:CHANGE_ME@private-CHANGE_ME.db.ondigitalocean.com:25060/impt?sslmode=require

# ── Redis — Upstash (TLS required, hence rediss:// not redis://) ──────────────
# Get this from: upstash.com → your database → .env tab → UPSTASH_REDIS_URL
REDIS_URL=rediss://:CHANGE_ME@CHANGE_ME.upstash.io:6379
CELERY_BROKER_URL=rediss://:CHANGE_ME@CHANGE_ME.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://:CHANGE_ME@CHANGE_ME.upstash.io:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong key with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_RANDOM_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Upload storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50

# ── CORS — your Vercel frontend URL and any custom domain ────────────────────
# Comma-separated. No trailing slashes.
ALLOWED_ORIGINS=https://CHANGE_ME.vercel.app

# ── IMPT settings ─────────────────────────────────────────────────────────────
IMPT_DEBUG=false
RATE_LIMIT_REQUESTS_PER_MINUTE=60
JOB_TIMEOUT_WATCHDOG_SECONDS=3900

# ── Default admin account ─────────────────────────────────────────────────────
# Created automatically on first startup if no account with ADMIN_EMAIL exists.
# Change these before first deploy, or update through the User Profile page.
ADMIN_EMAIL=admin@impt.local
ADMIN_PASSWORD=impt-admin-2026
ADMIN_NAME=IMPT Administrator
