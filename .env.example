# ─────────────────────────────────────────────────────────────────────────────
# IMPT v2 Environment Variables
# Copy to .env and fill every CHANGE_ME value.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database — DigitalOcean Managed PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://doadmin:CHANGE_ME@private-CHANGE_ME.db.ondigitalocean.com:25060/impt?ssl=require
DATABASE_URL_SYNC=postgresql+psycopg2://doadmin:CHANGE_ME@private-CHANGE_ME.db.ondigitalocean.com:25060/impt?sslmode=require

# ── Redis — Upstash (TLS) ──────────────────────────────────────────────────────
REDIS_URL=rediss://:CHANGE_ME@CHANGE_ME.upstash.io:6379
CELERY_BROKER_URL=rediss://:CHANGE_ME@CHANGE_ME.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://:CHANGE_ME@CHANGE_ME.upstash.io:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_CHAR_HEX
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Email — Resend ─────────────────────────────────────────────────────────────
# 1. Sign up at resend.com (free — 3,000 emails/month)
# 2. Add and verify your domain (impt.it.com) under Domains
# 3. Create an API key under API Keys
# 4. Set these two variables:
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM=IMPT <noreply@impt.it.com>

# ── Frontend URL (used in email verification and reset links) ─────────────────
FRONTEND_URL=https://www.impt.it.com

# ── CORS — your Vercel and custom domain ──────────────────────────────────────
ALLOWED_ORIGINS=https://CHANGE_ME.vercel.app,https://impt.it.com,https://www.impt.it.com

# ── Upload storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50

# ── Session and security settings ─────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
FILE_RETENTION_DAYS=90

# ── App ───────────────────────────────────────────────────────────────────────
IMPT_DEBUG=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100
JOB_TIMEOUT_WATCHDOG_SECONDS=3900
