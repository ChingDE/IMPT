api.impt.it.com {
    reverse_proxy localhost:8000 {
        flush_interval -1
        transport http {
            response_header_timeout 3600s
            dial_timeout             10s
        }
    }

    request_body {
        max_size 60MB
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output file /var/log/caddy/impt-access.log
        format json
    }
}
